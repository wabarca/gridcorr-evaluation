# Configuración de Entorno para GridCorr / Evaluación Climatológica MARN

# Directorios de datos y salidas
CHIRPTS_DATA_DIR=./DATA
CHIRPTS_OUT_DIR=./salidas

# Parámetros de ejecución
CHIRPTS_MAX_WORKERS=4
CHIRPTS_DPI_MAPS=300
CHIRPTS_LOG_LEVEL=INFO

# Configuración del servidor Streamlit
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
